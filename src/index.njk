---
layout: layout.njk
permalink: /
---
<h1>{{ site.title }}</h1>
<p class="lede">{{ site.description }}</p>

<section class="grid">
    {% for app in apps %}
        <article class="card">
            <img src="{{ app.logoPath }}" alt="{{ app.displayName }} logo" width="88" height="88">
            <div>
                <h2>
                    {{ app.displayName }}
                    {% if app.isOfficial %}<span class="badge">Official image</span>{% endif %}
                </h2>
                <p class="meta">{{ app.description }}</p>
                <p>
                    Definition:
                    <a href="{{ site.url }}/v4/apps/{{ app.name }}">/v4/apps/{{ app.name }}</a>
                    · Logo:
                    <a href="{{ app.logoPath }}">{{ app.logoUrl }}</a>
                </p>
            </div>
        </article>
    {% endfor %}
</section>

<p class="lede">Catalog JSON: <a href="{{ site.url }}/v4/list"><code>/v4/list</code></a></p>
